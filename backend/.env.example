# --- LLM provider (pick one; the client is provider-agnostic) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# fallback / alternative providers — set LLM_PROVIDER to switch, no code changes needed
# LLM_PROVIDER=openrouter
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_API_KEY=

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# --- Database (defaults to local sqlite if unset) ---
DATABASE_URL=postgresql://user:pass@host:5432/dealreview

# --- CORS: comma-separated frontend origin(s) ---
FRONTEND_ORIGIN=http://localhost:3000
