# --- LLM provider ---
# LLM_PROVIDER picks the primary. Every structured-output call automatically falls back through
# FALLBACK_ORDER in config.py (gemini -> groq -> openrouter) if the primary raises — set whichever
# keys you have below and it just works; no code changes needed to add/remove a provider.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=              # https://aistudio.google.com/apikey — 250k tokens/min free tier
                              # (keep billing OFF that Google Cloud project or the free tier disappears)

# Used automatically as a fallback if Gemini fails/quota-exhausts (and can be set as LLM_PROVIDER
# directly instead — no card needed, but only an 8,000 tokens/min shared budget)
GROQ_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b

# Also tried as a fallback if configured — many free (":free") models, tighter rate limits
OPENROUTER_API_KEY=

# Not part of the automatic fallback chain, but selectable directly:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# --- Database (defaults to local sqlite if unset) ---
DATABASE_URL=postgresql://user:pass@host:5432/dealreview

# --- CORS: comma-separated frontend origin(s) ---
FRONTEND_ORIGIN=http://localhost:3000
